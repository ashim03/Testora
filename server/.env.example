# Server environment configuration
# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/testora

# Secrets - generate strong random values (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
COOKIE_SECRET=change_me_cookie_secret_32_chars_min

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
MAX_FILE_SIZE_MB=20
AUDIO_MAX_SIZE_MB=30

# DECIDE_UPLOADS: use "cloudinary" or "local"
# Cloudinary (optional). Leave blank to fall back to local /tmp storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI writing/speaking feedback. Never commit the real API key.
# The platform reads AI_API_KEY/AI_MODEL/AI_BASE_URL (OpenAI-compatible /responses).
AI_API_KEY=
AI_MODEL=qwen-plus
AI_BASE_URL=https://api.openai.com/v1

# Optional speech-to-text. Falls back to AI_* values above when blank.
# STT_PROVIDER selects the adapter:
#   openai-compatible (default) – POST {base}/audio/transcriptions (whisper-style)
#   qwen-asr                      – Qwen3-ASR via chat/completions with input_audio
#                                    (works on Alibaba Model Studio MaaS gateways)
STT_PROVIDER=openai-compatible
STT_API_KEY=
STT_MODEL=qwen3-asr-flash-2026-02-10
STT_BASE_URL=https://api.openai.com/v1

# Speaking assessment limits
# Maximum recording length in seconds (default 180).
SPEAKING_MAX_DURATION_SEC=180
# Minimum recording length in seconds (default 5).
SPEAKING_MIN_DURATION_SEC=5
# Maximum audio upload size in MB for speaking attempts (default 30).
SPEAKING_MAX_SIZE_MB=30
# Keep raw recordings after processing by default. Since transcripts are stored,
# raw audio is deleted by default unless explicitly requested per attempt.
SPEAKING_KEEP_AUDIO=false
